# Dockerfile.node — ValiChord decentralised demo node
#
# Builds an image containing:
#   - Node.js 20 + @holochain/client
#   - The Holochain conductor binary (auto-downloaded if not present in demo/bin/)
#   - The kitsune2 bootstrap server binary (from demo/bin/kitsune2-bootstrap-srv)
#   - The compiled researcher.happ / validator.happ
#   - The demo/ Node.js scripts
#
# No manual setup required — docker compose up --build handles everything.
# Requires: Docker, Docker Compose, and ANTHROPIC_API_KEY in the environment.

ARG HOLOCHAIN_VERSION=0.7.0
# kitsune2 ships on its own version line; 0.7.0 pins kitsune2 0.5.0. The binary
# comes from the Holochain release, so these two must be bumped together.
ARG KITSUNE2_VERSION=0.5.0
ARG HOLOCHAIN_BASE=https://github.com/holochain/holochain/releases/download/holochain-${HOLOCHAIN_VERSION}

FROM node:20-bookworm-slim

ARG HOLOCHAIN_VERSION
ARG KITSUNE2_VERSION
ARG HOLOCHAIN_BASE

# Runtime dependencies for the Holochain binary.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates bash netcat-openbsd curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Node.js dependencies (cache layer — only re-runs when package.json changes).
COPY demo/package.json demo/package-lock.json* /app/demo/
RUN cd /app/demo && npm install --omit=dev

# Copy pre-built binaries.
COPY demo/bin/ /app/demo/bin/
RUN chmod +x /app/demo/bin/kitsune2-bootstrap-srv

# Use a bundled binary only when it is the RIGHT VERSION for this build;
# otherwise download the arch-matched build from the Holochain release (which
# also ships kitsune2-bootstrap-srv).
#
# ⚠️ This check used to be `--version >/dev/null` — i.e. "does it execute?" — and
# that is a check that cannot fail for the case that matters. The committed
# demo/bin/kitsune2-bootstrap-srv is 0.4.1 (Holochain 0.6.2's kitsune2 line) and
# executes perfectly well on x86_64, so on the 0.7 bump it would have been
# silently preferred over the 0.5.0 the release ships — and 0.7 bumped the p2p
# wire protocol 2 -> 3, so the nodes would have failed to talk to each other with
# no hint that the bootstrap server was the wrong build. Matching the version
# string subsumes the old arch check too: a wrong-arch binary cannot exec, so it
# produces no output and no match, and the download still fires.
RUN set -e; \
    case "$(uname -m)" in \
        x86_64)  target="x86_64-unknown-linux-gnu" ;; \
        aarch64) target="aarch64-unknown-linux-gnu" ;; \
        *) echo "Unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    for bin in holochain kitsune2-bootstrap-srv; do \
        case "$bin" in \
            holochain)              want="${HOLOCHAIN_VERSION}" ;; \
            kitsune2-bootstrap-srv) want="${KITSUNE2_VERSION}" ;; \
        esac; \
        if [ -f "/app/demo/bin/$bin" ] && chmod +x "/app/demo/bin/$bin" \
            && "/app/demo/bin/$bin" --version 2>/dev/null | grep -Fq " $want"; then \
            echo "Using bundled $bin (matches $want)."; \
        else \
            echo "Downloading $bin $want ($target)..."; \
            curl -fsSL "${HOLOCHAIN_BASE}/$bin-$target" -o "/app/demo/bin/$bin"; \
            chmod +x "/app/demo/bin/$bin"; \
        fi; \
        "/app/demo/bin/$bin" --version 2>/dev/null | grep -Fq " $want" \
            || { echo "FATAL: $bin is not $want after setup" >&2; exit 1; }; \
    done

# Copy the compiled role-filtered happs.
COPY valichord/workdir/ /app/valichord/workdir/

# Copy demo scripts.
COPY demo/*.mjs demo/*.yaml demo/*.sh /app/demo/

RUN chmod +x /app/demo/node-entrypoint.sh

# Put demo/bin/ on PATH so `holochain` and `kitsune2-bootstrap-srv` are found.
ENV PATH="/app/demo/bin:$PATH"
# HAPP_PATH is resolved by node-entrypoint.sh based on ROLE
# (researcher.happ or validator.happ) so it is NOT set here.

# node-entrypoint.sh starts the conductor, runs node-setup.mjs, then starts
# the role-specific node API (researcher-node.mjs or validator-node.mjs).
CMD ["/bin/bash", "/app/demo/node-entrypoint.sh"]
